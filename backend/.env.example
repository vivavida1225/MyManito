DJANGO_SECRET_KEY=replace-with-a-long-random-value
# 운영 배포 시 별도로 생성하며 교체하면 기존 서비스 JWT가 모두 즉시 무효화됩니다.
JWT_SIGNING_KEY=replace-with-a-separate-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CHANNEL_REDIS_URL=redis://redis:6379/0
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
MYMANITO_APP_URL=https://mymanito.wara.synology.me
# Firebase Console에서 내려받은 서비스 계정 JSON 전체를 한 줄로 넣거나, 컨테이너 안의 JSON 파일 경로를 지정합니다.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
# iOS 홈 화면 웹앱 표준 Web Push 전용 VAPID 키입니다. Firebase VAPID 키와 별도로 생성하세요.
IOS_WEB_PUSH_VAPID_PRIVATE_KEY=
IOS_WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
SCHEDULER_ENABLED=true
